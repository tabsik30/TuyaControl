{
  "version": 1,
  "include": [
    "README.md",
    "THIRD-PARTY-NOTICES"
  ],
  "targets": {
    "win-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish",
        "TuyaControl.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-p:UseAppHost=false",
        "-o",
        "bin/publish/win-x64"
      ],
      "output": "bin/publish/win-x64"
    }
  }
}
